{
  "functions": {
    "source": "functions"
  },
  "hosting": {
    "public": "dist",
    "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
    "rewrites": [
      { "source": "/api/agent/report", "run": { "serviceId": "cybernet-api", "region": "us-central1" } },
      { "source": "/api/**", "run": { "serviceId": "cybernet-api", "region": "us-central1" } },
      { "source": "/sse/**", "run": { "serviceId": "cybernet-api", "region": "us-central1" } },
      { "source": "**", "destination": "/index.html" }
    ],
    "headers": [
      {
        "source": "**/*",
        "headers": [
          { "key": "Cache-Control", "value": "no-cache" },
          { "key": "X-Content-Type-Options", "value": "nosniff" },
          { "key": "Referrer-Policy", "value": "no-referrer" }
        ]
      }
    ],
    "cleanUrls": true,
    "trailingSlash": false
  }
}
