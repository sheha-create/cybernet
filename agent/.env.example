# CYBERNET collector agent configuration.
# Copy this file to `.env` in the same folder and fill in your values.

# Base URL of your CYBERNET server.
CYBERNET_SERVER_URL=http://localhost:3001

# Token generated from the dashboard: Config tab > Collector Agent > Generate token.
CYBERNET_AGENT_TOKEN=

# How often to report, in milliseconds (minimum 2000).
CYBERNET_INTERVAL_MS=5000
