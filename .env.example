# Server listener. Defaults are suitable for a single local deployment.
PORT=3001

# Keep false unless the application is behind a reverse proxy you operate.
TRUST_PROXY=false

# Detection and retention settings.
REQUEST_RATE_LIMIT=30
EVENT_RETENTION_DAYS=30

# Optional absolute paths for persistent deployment volumes.
# LOG_DIR=./logs
# DB_PATH=./data/security-events.sqlite
